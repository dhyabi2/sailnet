# secrets: never commit wallets or seeds
.wallet/
deploy/wallets/
docker/wallets/
docker/.env
**/wallet.json
**/*-wallet.json
release.jks
# the Android signing key: the app's identity. Losing it means no user can
# ever upgrade in place again; publishing it means anyone can forge updates.
deploy/android/
*.p12
*.jks
keystore-password.txt
# build output
sail/bin/
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/app/libs/sail.aar
android/app/libs/sail-sources.jar
*.apk
*.zip
.DS_Store

# operator identity and per-deploy records never go in git
deploy/state/
docs/research/deploy*.log
docs/research/fund*.log
extension/out/
.vercel/
