<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="Identity">
        <EditTextPreference
            android:key="nick"
            android:title="Nickname"
            android:summary="Replaces your address in logs."
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Circuit">
        <MultiSelectListPreference
            android:key="exclude_cc"
            android:title="Never exit through"
            android:summary="Countries never used as exit."
            android:entries="@array/empty"
            android:entryValues="@array/empty" />
        <Preference
            android:key="relay"
            android:title="My relay"
            android:summary="Open network" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Censored networks">
        <EditTextPreference
            android:key="bridges"
            android:title="Bridge lines"
            android:summary="Only if the built-in entries are blocked."
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Wallet">
        <Preference
            android:key="wallet_backup"
            android:title="Back up wallet"
            android:summary="Show the seed." />
        <Preference
            android:key="wallet_restore"
            android:title="Restore wallet"
            android:summary="From a seed you saved." />
    </PreferenceCategory>
</PreferenceScreen>
