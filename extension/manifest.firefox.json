{
  "manifest_version": 3,
  "name": "Sailnet",
  "version": "0.2",
  "description": "Route this browser through your local Sailnet client: SOCKS5 with remote DNS, WebRTC leak protection, live circuit status.",
  "permissions": [
    "proxy",
    "privacy",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sailnet",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sailnet@sailnet.net",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}